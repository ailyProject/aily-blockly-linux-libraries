      { "type": "field_input", "name": "NAME", "text": "stepper" },
      { "type": "input_value", "name": "STEPS", "check": "Number" },
      { "type": "input_value", "name": "RPM", "check": "Number" }
    ],
    "colour": "#00897B",
    "tooltip": "Move by signed sequence steps; negative values reverse direction.",
    "icon": "fa-light fa-arrows-rotate",
    "previousStatement": null,
    "nextStatement": null
  },
  {
    "type": "linux_stepper_rotate",
    "message0": "rotate stepper %1 by signed angle %2 degrees at %3 RPM",
    "args0": [
      { "type": "field_input", "name": "NAME", "text": "stepper" },
      { "type": "input_value", "name": "ANGLE", "check": "Number" },
      { "type": "input_value", "name": "RPM", "check": "Number" }
    ],
    "colour": "#00897B",
    "tooltip": "Convert a signed angle to the configured sequence steps and move.",
    "icon": "fa-light fa-arrows-rotate",
    "previousStatement": null,
    "nextStatement": null
