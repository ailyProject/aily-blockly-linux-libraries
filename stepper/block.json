[
  {
    "type": "linux_stepper_init",
    "message0": "initialize stepper %1 pins IN1 %2 IN2 %3 IN3 %4 IN4 %5 mode %6 steps per revolution %7 after move %8",
    "args0": [
      { "type": "field_input", "name": "NAME", "text": "stepper" },
      { "type": "field_dropdown", "name": "PIN1", "options": "${board.digitalPins}" },
      { "type": "field_dropdown", "name": "PIN2", "options": "${board.digitalPins}" },
      { "type": "field_dropdown", "name": "PIN3", "options": "${board.digitalPins}" },
      { "type": "field_dropdown", "name": "PIN4", "options": "${board.digitalPins}" },
      {
        "type": "field_dropdown",
        "name": "MODE",
        "options": [["full step", "FULL"], ["half step", "HALF"]]
      },
      { "type": "input_value", "name": "STEPS_PER_REVOLUTION", "check": "Number" },
      {
        "type": "field_dropdown",
        "name": "HOLD",
        "options": [["hold coils", "HOLD"], ["release coils", "RELEASE"]]
      }
    ],
    "colour": "#00897B",
    "tooltip": "Create a deterministic four-output stepper controller for an external driver.",
    "icon": "fa-light fa-plug",
    "previousStatement": null,
    "nextStatement": null
  },
  {
    "type": "linux_stepper_move",
    "message0": "move stepper %1 by signed steps %2 at %3 RPM",
